<Window
    x:Class="CRT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!--
                NavigationView paints opaque layer brushes across the pane and
                the content area, which covered the Mica backdrop completely.
                Clearing them lets the backdrop show through; the card styles in
                App.xaml still supply the layered surfaces on top of it.
            -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Drag region for the extended title bar. Content reaches into the
            caption area so the title bar picks up both the app theme and the
            Mica backdrop; the right inset is reserved at runtime for the system
            caption buttons.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                x:Name="TitleBarIcon"
                Grid.Column="0"
                Width="16"
                Height="16"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="TitleBarText"
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <InfoBar
            x:Name="UpdateBanner"
            Grid.Row="1"
            IsOpen="False"
            Severity="Informational"
            IsClosable="True" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            Background="Transparent"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="200"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavRetimer" Tag="retimer">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavVideo" Tag="video">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Frame x:Name="ContentFrame" />
                <ProgressBar
                    x:Name="BusyBar"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <InfoBar
            x:Name="ToastBar"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            IsClosable="False"
            IsOpen="False"
            Severity="Success" />
    </Grid>
</Window>
