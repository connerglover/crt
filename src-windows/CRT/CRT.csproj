<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>CRT</RootNamespace>
    <AssemblyName>CRT</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <!--
    Publish as one executable. Self-contained already meant the user needed
    nothing installed, but it spread ~150 files beside the app; this packs them
    into the host and extracts to a cache on first run.

    IncludeNativeLibrariesForSelfExtract is required, not optional: WinUI ships
    native DLLs and without it they stay loose next to the exe, which is the
    thing being avoided.

    EnableCompressionInSingleFile is deliberately off. Measured on this app it
    takes the exe from 154 MB to 63 MB, but the release asset is a zip either
    way and that only moves the download from 59 MB to 57 MB — while startup
    goes from 0.6s to 3.0s on every launch, not just the first. A retiming tool
    is opened constantly, so two megabytes is not worth five times the start.
  -->
  <PropertyGroup Condition="'$(PublishSingleFileOverride)' != 'false'">
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Stated here as well as on the publish command, or the SDK warns that
         single-file is only recommended alongside self-contained. -->
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CRT.Core\CRT.Core.csproj" />
  </ItemGroup>

</Project>
