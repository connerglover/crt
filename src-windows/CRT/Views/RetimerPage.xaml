<Page
    x:Class="CRT.Views.RetimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CRT.Views"
    xmlns:vm="using:CRT.ViewModels"
    NavigationCacheMode="Required">

    <Grid RowSpacing="8" Padding="16,4,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:RetimerMenuBar Grid.Row="0" x:Name="MenuBarControl" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ModeCaption"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="SemiBold" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Opacity="0.6"
                Text="{x:Bind VM.WindowSubtitle, Mode=OneWay}" />
            <ToggleButton
                x:Name="SidebarToggle"
                Grid.Column="2"
                IsChecked="True"
                Click="OnSidebarToggle"
                Visibility="{x:Bind Invert(VM.IsSegmentMode), Mode=OneWay}"
                Content="☰" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidebarColumn" Width="280" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <!-- Time cards -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PrimaryCard"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Padding="0,14"
                            Click="OnPrimaryCardClick">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TimeCardLabelStyle}" Text="{x:Bind VM.PrimaryLabel, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TimeCardValueStyle}" Text="{x:Bind VM.PrimaryTimeText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SecondaryCard"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Padding="0,14"
                            Click="OnSecondaryCardClick">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TimeCardLabelStyle}" Text="{x:Bind VM.SecondaryLabel, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TimeCardValueStyle}" Text="{x:Bind VM.SecondaryTimeText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Framerate row -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FramerateLabel" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="FramerateBox"
                            Grid.Column="1"
                            Text="{x:Bind VM.FramerateText, Mode=OneWay}"
                            LostFocus="OnFramerateCommit"
                            KeyDown="OnInputKeyDown" />
                        <DropDownButton Grid.Column="2" Content="⯆">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="FramerateQuickFlyout" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- Start frame row (hidden in segment mode) -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind Invert(VM.IsSegmentMode), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StartFrameLabel" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="StartFrameBox"
                            Grid.Column="1"
                            Text="{x:Bind VM.StartFrameText, Mode=OneWay}"
                            LostFocus="OnStartFrameCommit"
                            KeyDown="OnInputKeyDown" />
                        <Button x:Name="StartPasteButton" Grid.Column="2" Click="OnPasteStart" />
                    </Grid>

                    <!-- End frame row (hidden in segment mode) -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind Invert(VM.IsSegmentMode), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EndFrameLabel" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="EndFrameBox"
                            Grid.Column="1"
                            Text="{x:Bind VM.EndFrameText, Mode=OneWay}"
                            LostFocus="OnEndFrameCommit"
                            KeyDown="OnInputKeyDown" />
                        <Button x:Name="EndPasteButton" Grid.Column="2" Click="OnPasteEnd" />
                    </Grid>

                    <!-- Range start row (classic mode only) -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind Invert(VM.IsSegmentMode), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind VM.RangeStartLabel, Mode=OneWay}" />
                        <TextBox
                            x:Name="RangeStartBox"
                            Grid.Column="1"
                            Text="{x:Bind VM.RangeStartText, Mode=OneWay}"
                            LostFocus="OnRangeStartCommit"
                            KeyDown="OnInputKeyDown" />
                        <Button x:Name="RangeStartPasteButton" Grid.Column="2" Click="OnPasteRangeStart" />
                    </Grid>

                    <!-- Range end row (classic mode only) -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind Invert(VM.IsSegmentMode), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind VM.RangeEndLabel, Mode=OneWay}" />
                        <TextBox
                            x:Name="RangeEndBox"
                            Grid.Column="1"
                            Text="{x:Bind VM.RangeEndText, Mode=OneWay}"
                            LostFocus="OnRangeEndCommit"
                            KeyDown="OnInputKeyDown" />
                        <Button x:Name="RangeEndPasteButton" Grid.Column="2" Click="OnPasteRangeEnd" />
                    </Grid>

                    <!-- Action buttons -->
                    <Grid ColumnSpacing="12" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SplitButton
                            x:Name="CopyModNoteButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentSplitButtonStyle}"
                            Click="OnCopyModNote">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="FlyoutCopyDiscord" Click="OnMenuCopyDiscord" />
                                    <MenuFlyoutItem x:Name="FlyoutCopyChapters" Click="OnMenuCopyChapters" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Content="{x:Bind VM.AddRangeLabel, Mode=OneWay}"
                            Command="{x:Bind VM.AddRangeCommand}" />
                    </Grid>

                    <!--
                        Segment rows are edited here rather than in the sidebar:
                        each carries its own start/end fields, paste buttons and
                        running duration, so the whole run is visible at once.
                    -->
                    <StackPanel Spacing="6" Visibility="{x:Bind VM.IsSegmentMode, Mode=OneWay}">
                        <TextBlock
                            x:Name="NoSegmentsHint"
                            Opacity="0.6"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Invert(VM.HasRows), Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind VM.Rows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RangeRowViewModel">
                                    <Grid ColumnSpacing="6" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Padding="6,2"
                                            FontSize="11"
                                            Content="✕"
                                            Command="{x:Bind DeleteCommand}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            MinWidth="78"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Title}" />
                                        <TextBox
                                            Grid.Column="2"
                                            Tag="start"
                                            Text="{x:Bind StartText, Mode=OneWay}"
                                            LostFocus="OnRowFieldLostFocus"
                                            KeyDown="OnRowFieldKeyDown" />
                                        <Button
                                            Grid.Column="3"
                                            Content="{x:Bind PasteLabel}"
                                            Command="{x:Bind PasteStartCommand}" />
                                        <TextBox
                                            Grid.Column="4"
                                            Tag="end"
                                            Text="{x:Bind EndText, Mode=OneWay}"
                                            LostFocus="OnRowFieldLostFocus"
                                            KeyDown="OnRowFieldKeyDown" />
                                        <Button
                                            Grid.Column="5"
                                            Content="{x:Bind PasteLabel}"
                                            Command="{x:Bind PasteEndCommand}" />
                                        <Border
                                            Grid.Column="6"
                                            MinWidth="86"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            VerticalAlignment="Stretch"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind DurationText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <views:SessionSidebar
                x:Name="Sidebar"
                Grid.Column="1"
                Visibility="{x:Bind Invert(VM.IsSegmentMode), Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
