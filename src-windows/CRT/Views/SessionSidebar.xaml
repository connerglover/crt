<UserControl
    x:Class="CRT.Views.SessionSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CRT.ViewModels">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontWeight="SemiBold"
            Text="{x:Bind VM.RowsHeader, Mode=OneWay}" />

        <TextBlock
            Grid.Row="1"
            Opacity="0.6"
            TextWrapping="Wrap"
            Visibility="{x:Bind IsEmptyVisible(VM.HasRows), Mode=OneWay}"
            Text="{x:Bind VM.RowsEmptyText, Mode=OneWay}" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind VM.HasRows, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind VM.Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RangeRowViewModel">
                        <Border
                            Style="{StaticResource CardBorderStyle}"
                            Padding="10,8"
                            Margin="0,0,0,8">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Title}" />
                                    <Border
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Text="{x:Bind DurationText}" />
                                    </Border>
                                    <Button
                                        Grid.Column="2"
                                        Padding="4,2"
                                        Content="✕"
                                        FontSize="11"
                                        Command="{x:Bind DeleteCommand}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="Start" />
                                    <TextBox
                                        Width="76"
                                        FontSize="12"
                                        Tag="start"
                                        Text="{x:Bind StartText, Mode=OneWay}"
                                        LostFocus="OnRowFieldLostFocus"
                                        KeyDown="OnRowFieldKeyDown" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="End" />
                                    <TextBox
                                        Width="76"
                                        FontSize="12"
                                        Tag="end"
                                        Text="{x:Bind EndText, Mode=OneWay}"
                                        LostFocus="OnRowFieldLostFocus"
                                        KeyDown="OnRowFieldKeyDown" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            IsEnabled="{x:Bind VM.CanClearRows, Mode=OneWay}"
            Content="{x:Bind VM.ClearRowsLabel, Mode=OneWay}"
            Command="{x:Bind VM.ClearRowsCommand}" />
    </Grid>
</UserControl>
