<Page
    x:Class="CRT.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="24,12,24,24" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock x:Name="PageHeader" FontSize="22" FontWeight="SemiBold" />

            <CheckBox x:Name="UpdatesCheck" IsChecked="{x:Bind VM.EnableUpdates, Mode=TwoWay}" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ThemeLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="ThemeCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.ThemeIndex, Mode=TwoWay}" />

                <TextBlock x:Name="AccentLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="AccentSwatch"
                        Width="28"
                        Height="28"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox x:Name="AccentBox" Width="120" Text="{x:Bind VM.AccentColor, Mode=TwoWay}" TextChanged="OnAccentTextChanged" />
                    <Button x:Name="PickColorButton">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker
                                    x:Name="AccentPicker"
                                    IsAlphaEnabled="False"
                                    ColorChanged="OnAccentPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="LanguageLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="LanguageCombo"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.LanguageIndex, Mode=TwoWay}" />

                <TextBlock x:Name="ModNoteLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="64"
                    Text="{x:Bind VM.ModNoteFormat, Mode=TwoWay}" />

                <TextBlock x:Name="TimerCornerLabel" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="TimerCornerCombo"
                    Grid.Row="4"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.TimerCornerIndex, Mode=TwoWay}" />

                <TextBlock x:Name="TimerStyleLabel" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="TimerStyleCombo"
                    Grid.Row="5"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.TimerStyleIndex, Mode=TwoWay}" />

                <TextBlock x:Name="FfmpegLabel" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{x:Bind VM.FfmpegPath, Mode=TwoWay}" />

                <TextBlock x:Name="YtDlpLabel" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{x:Bind VM.YtDlpPath, Mode=TwoWay}" />

                <TextBlock x:Name="DefaultModeLabel" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="DefaultModeCombo"
                    Grid.Row="8"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.DefaultModeIndex, Mode=TwoWay}" />
            </Grid>

            <Button x:Name="HotkeysButton" Command="{x:Bind VM.CustomizeHotkeysCommand}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.ApplyCommand}" />
                <Button x:Name="CancelButton" Command="{x:Bind VM.CancelCommand}" />
                <Button x:Name="RestoreButton" Command="{x:Bind VM.RestoreDefaultsCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
