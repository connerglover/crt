<Page
    x:Class="CRT.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--
            Grouped by what each setting affects rather than by when it was
            added: the timer options in particular had content, text, background
            and placement controls interleaved in one flat list.
        -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>
        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Padding="24,12,24,24" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock x:Name="PageHeader" FontSize="22" FontWeight="SemiBold" />

            <!-- ── General ─────────────────────────────────────────────── -->
            <TextBlock x:Name="GeneralHeader" Style="{StaticResource SectionHeaderStyle}" />

            <CheckBox x:Name="UpdatesCheck" IsChecked="{x:Bind VM.EnableUpdates, Mode=TwoWay}" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ThemeLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox
                    x:Name="ThemeCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.ThemeIndex, Mode=TwoWay}" />

                <TextBlock x:Name="AccentLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="AccentSwatch"
                        Width="28"
                        Height="28"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox x:Name="AccentBox" Width="120" Text="{x:Bind VM.AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnAccentTextChanged" />
                    <Button x:Name="PickColorButton">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" ColorChanged="OnAccentPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="LanguageLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox
                    x:Name="LanguageCombo"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.LanguageIndex, Mode=TwoWay}" />
            </Grid>

            <!-- ── Timing ──────────────────────────────────────────────── -->
            <TextBlock x:Name="TimingHeader" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Spacing="4">
                <CheckBox x:Name="ClassicModeCheck" IsChecked="{x:Bind VM.ClassicMode, Mode=TwoWay}" />
                <TextBlock x:Name="ClassicModeHint" Style="{StaticResource HintStyle}" Margin="30,0,0,0" />
            </StackPanel>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ModNoteLabel" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox
                    Grid.Column="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="60"
                    Text="{x:Bind VM.ModNoteFormat, Mode=TwoWay}" />
            </Grid>

            <!-- ── In-video timer ──────────────────────────────────────── -->
            <TextBlock x:Name="TimerHeader" Style="{StaticResource SectionHeaderStyle}" />

            <TextBlock x:Name="TimerContentHeader" Style="{StaticResource SubHeaderStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TimerPresetLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox
                    x:Name="TimerPresetCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.TimerPresetIndex, Mode=TwoWay}" />

                <TextBlock x:Name="TimerFormatLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBox
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="60"
                        FontFamily="Consolas"
                        Text="{x:Bind VM.TimerFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="TimerFormatHint" Style="{StaticResource HintStyle}" />
                </StackPanel>

                <TextBlock x:Name="ClockStyleLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <ComboBox
                        x:Name="ClockStyleCombo"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind VM.ClockStyleIndex, Mode=TwoWay}" />
                    <TextBlock x:Name="ClockStyleHint" Style="{StaticResource HintStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TimerTextHeader" Style="{StaticResource SubHeaderStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TimerFontLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!--
                        Each family is drawn in itself, so the list reads as a
                        specimen sheet rather than a column of identical labels.
                    -->
                    <ComboBox x:Name="TimerFontCombo" MinWidth="260" MaxDropDownHeight="360" SelectedIndex="{x:Bind VM.TimerFontIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="TimerWeightCombo" MinWidth="120" SelectedIndex="{x:Bind VM.TimerWeightIndex, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock x:Name="TimerSizeLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider x:Name="TimerSizeSlider" Width="240" Minimum="1" Maximum="20" StepFrequency="0.5" Value="{x:Bind VM.TimerTextSize, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind VM.TimerTextSizeText, Mode=OneWay}" />
                </StackPanel>

                <TextBlock x:Name="TimerTextColorLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border x:Name="TimerTextSwatch" Width="28" Height="28" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox Width="120" Text="{x:Bind VM.TimerTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnTimerTextColorChanged" />
                    <Button x:Name="TimerTextColorButton">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="TimerTextPicker" IsAlphaEnabled="False" ColorChanged="OnTimerTextColorPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TimerOutlineLabel" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider x:Name="TimerOutlineSlider" Width="240" Minimum="0" Maximum="10" Value="{x:Bind VM.TimerOutlineWidth, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind VM.TimerOutlineWidthText, Mode=OneWay}" />
                </StackPanel>

                <ContentControl Grid.Row="4" Grid.Column="0" IsTabStop="False" IsEnabled="{x:Bind VM.OutlineSettingsEnabled, Mode=OneWay}">
                    <TextBlock x:Name="TimerOutlineColorLabel" Style="{StaticResource FieldLabelStyle}" />
                </ContentControl>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border x:Name="TimerOutlineSwatch" Width="28" Height="28" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox Width="120" IsEnabled="{x:Bind VM.OutlineSettingsEnabled, Mode=OneWay}" Text="{x:Bind VM.TimerOutlineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnTimerOutlineColorChanged" />
                    <Button x:Name="TimerOutlineColorButton" IsEnabled="{x:Bind VM.OutlineSettingsEnabled, Mode=OneWay}">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="TimerOutlinePicker" IsAlphaEnabled="False" ColorChanged="OnTimerOutlineColorPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TimerBackgroundHeader" Style="{StaticResource SubHeaderStyle}" />
            <CheckBox x:Name="TimerBackgroundCheck" IsChecked="{x:Bind VM.TimerBackground, Mode=TwoWay}" />

            <!--
                These only affect a background that is actually drawn, so they
                disable with the checkbox rather than staying live and inert.
            -->
            <ContentControl
                IsTabStop="False"
                HorizontalContentAlignment="Stretch"
                IsEnabled="{x:Bind VM.BackgroundSettingsEnabled, Mode=OneWay}">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TimerBackgroundColorLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border x:Name="TimerBackgroundSwatch" Width="28" Height="28" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox Width="120" Text="{x:Bind VM.TimerBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnTimerBackgroundColorChanged" />
                    <Button x:Name="TimerBackgroundColorButton">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="TimerBackgroundPicker" IsAlphaEnabled="False" ColorChanged="OnTimerBackgroundColorPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TimerOpacityLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider x:Name="TimerOpacitySlider" Width="240" Minimum="0" Maximum="100" Value="{x:Bind VM.TimerBackgroundOpacity, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind VM.TimerBackgroundOpacityText, Mode=OneWay}" />
                </StackPanel>

                <TextBlock x:Name="TimerCornersLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider x:Name="TimerCornersSlider" Width="240" Minimum="0" Maximum="40" Value="{x:Bind VM.TimerCornerRadius, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind VM.TimerCornerRadiusText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            </ContentControl>

            <TextBlock x:Name="TimerLayoutHeader" Style="{StaticResource SubHeaderStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TimerCornerLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox
                    x:Name="TimerCornerCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.TimerCornerIndex, Mode=TwoWay}" />

                <TextBlock x:Name="TimerSpacingLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider x:Name="TimerSpacingSlider" Width="240" Minimum="0.5" Maximum="2.5" StepFrequency="0.05" Value="{x:Bind VM.TimerLineSpacing, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind VM.TimerLineSpacingText, Mode=OneWay}" />
                </StackPanel>

                <Button x:Name="PreviewTimerButton" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Command="{x:Bind VM.PreviewTimerCommand}" />
            </Grid>

            <!-- ── Tools ───────────────────────────────────────────────── -->
            <TextBlock x:Name="ToolsHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="FfmpegLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind VM.FfmpegPath, Mode=TwoWay}" />

                <TextBlock x:Name="YtDlpLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind VM.YtDlpPath, Mode=TwoWay}" />
            </Grid>

            <!-- ── Shortcuts ───────────────────────────────────────────── -->
            <TextBlock x:Name="ShortcutsHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Button x:Name="HotkeysButton" HorizontalAlignment="Left" Command="{x:Bind VM.CustomizeHotkeysCommand}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.ApplyCommand}" />
                <Button x:Name="CancelButton" Command="{x:Bind VM.CancelCommand}" />
                <Button x:Name="RestoreButton" Command="{x:Bind VM.RestoreDefaultsCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
