<Page
    x:Class="CRT.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="24,12,24,24" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock x:Name="PageHeader" FontSize="22" FontWeight="SemiBold" />

            <CheckBox x:Name="UpdatesCheck" IsChecked="{x:Bind VM.EnableUpdates, Mode=TwoWay}" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ThemeLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="ThemeCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.ThemeIndex, Mode=TwoWay}" />

                <TextBlock x:Name="AccentLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="AccentSwatch"
                        Width="28"
                        Height="28"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox x:Name="AccentBox" Width="120" Text="{x:Bind VM.AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnAccentTextChanged" />
                    <Button x:Name="PickColorButton">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker
                                    x:Name="AccentPicker"
                                    IsAlphaEnabled="False"
                                    ColorChanged="OnAccentPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="LanguageLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="LanguageCombo"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.LanguageIndex, Mode=TwoWay}" />

                <TextBlock x:Name="ModNoteLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="64"
                    Text="{x:Bind VM.ModNoteFormat, Mode=TwoWay}" />

                <TextBlock x:Name="FfmpegLabel" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{x:Bind VM.FfmpegPath, Mode=TwoWay}" />

                <TextBlock x:Name="YtDlpLabel" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{x:Bind VM.YtDlpPath, Mode=TwoWay}" />

            </Grid>

            <!--
                Timing mode and the dual-timer export are single opt-ins, so they
                are checkboxes here rather than a control on the retimer page.
            -->
            <StackPanel Spacing="4">
                <CheckBox x:Name="ClassicModeCheck" IsChecked="{x:Bind VM.ClassicMode, Mode=TwoWay}" />
                <TextBlock x:Name="ClassicModeHint" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="30,0,0,0" />
            </StackPanel>

            <!-- In-video timer: what it says, then separately how it looks. -->
            <TextBlock x:Name="TimerHeader" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TimerPresetLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="TimerPresetCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind VM.TimerPresetIndex, Mode=TwoWay}" />

                <TextBlock x:Name="TimerFormatLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBox
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="64"
                        FontFamily="Consolas"
                        Text="{x:Bind VM.TimerFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="TimerFormatHint" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Name="ClockStyleLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <ComboBox
                        x:Name="ClockStyleCombo"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind VM.ClockStyleIndex, Mode=TwoWay}" />
                    <TextBlock x:Name="ClockStyleHint" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TimerLookHeader" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TimerFontLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="TimerFontCombo" MinWidth="200" SelectedIndex="{x:Bind VM.TimerFontIndex, Mode=TwoWay}" />
                    <ComboBox x:Name="TimerWeightCombo" MinWidth="120" SelectedIndex="{x:Bind VM.TimerWeightIndex, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock x:Name="TimerSizeLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider
                        x:Name="TimerSizeSlider"
                        Width="240"
                        Minimum="1"
                        Maximum="20"
                        StepFrequency="0.5"
                        Value="{x:Bind VM.TimerTextSize, Mode=TwoWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        Text="{x:Bind VM.TimerTextSizeText, Mode=OneWay}" />
                </StackPanel>

                <TextBlock x:Name="TimerSpacingLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider
                        x:Name="TimerSpacingSlider"
                        Width="240"
                        Minimum="1"
                        Maximum="2.5"
                        StepFrequency="0.05"
                        Value="{x:Bind VM.TimerLineSpacing, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind VM.TimerLineSpacingText, Mode=OneWay}" />
                </StackPanel>

                <TextBlock x:Name="TimerTextColorLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="TimerTextSwatch"
                        Width="28"
                        Height="28"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox Width="120" Text="{x:Bind VM.TimerTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnTimerTextColorChanged" />
                    <Button x:Name="TimerTextColorButton">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="TimerTextPicker" IsAlphaEnabled="False" ColorChanged="OnTimerTextColorPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <CheckBox
                    x:Name="TimerBackgroundCheck"
                    Grid.Row="4"
                    Grid.Column="1"
                    IsChecked="{x:Bind VM.TimerBackground, Mode=TwoWay}" />

                <TextBlock x:Name="TimerBackgroundColorLabel" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border
                        x:Name="TimerBackgroundSwatch"
                        Width="28"
                        Height="28"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBox Width="120" Text="{x:Bind VM.TimerBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnTimerBackgroundColorChanged" />
                    <Button x:Name="TimerBackgroundColorButton">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="TimerBackgroundPicker" IsAlphaEnabled="False" ColorChanged="OnTimerBackgroundColorPicked" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TimerOpacityLabel" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Slider
                        x:Name="TimerOpacitySlider"
                        Width="240"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind VM.TimerBackgroundOpacity, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind VM.TimerBackgroundOpacityText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimerCornerLabel" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <ComboBox
                        x:Name="TimerCornerCombo"
                        MinWidth="220"
                        SelectedIndex="{x:Bind VM.TimerCornerIndex, Mode=TwoWay}" />
                    <Button x:Name="PreviewTimerButton" Command="{x:Bind VM.PreviewTimerCommand}" />
                </StackPanel>
            </Grid>

            <Button x:Name="HotkeysButton" Command="{x:Bind VM.CustomizeHotkeysCommand}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.ApplyCommand}" />
                <Button x:Name="CancelButton" Command="{x:Bind VM.CancelCommand}" />
                <Button x:Name="RestoreButton" Command="{x:Bind VM.RestoreDefaultsCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
