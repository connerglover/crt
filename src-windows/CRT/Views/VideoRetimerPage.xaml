<Page
    x:Class="CRT.Views.VideoRetimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CRT.Views"
    NavigationCacheMode="Required">

    <Grid ColumnSpacing="16" RowSpacing="10" Padding="16,4,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <views:RetimerMenuBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MenuBarControl" />

        <!-- Import box -->
        <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="ImportBox"
                Grid.Column="0"
                Text="{x:Bind VM.ImportUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="OnImportKeyDown" />
            <Button x:Name="ImportButton" Grid.Column="1" Command="{x:Bind VM.ImportCommand}" />
            <Button x:Name="BrowseButton" Grid.Column="2" Command="{x:Bind VM.BrowseCommand}" />
        </Grid>

        <!-- Player -->
        <Grid Grid.Row="2" Grid.Column="0" MinHeight="240">
            <MediaPlayerElement
                x:Name="PlayerElement"
                AreTransportControlsEnabled="False"
                Stretch="Uniform" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6"
                TextWrapping="Wrap"
                TextAlignment="Center"
                MaxWidth="420"
                Visibility="{x:Bind Invert(VM.HasVideo), Mode=OneWay}" />
        </Grid>

        <!-- Timeline -->
        <Grid Grid.Row="3" Grid.Column="0" RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Canvas x:Name="RegionsCanvas" Grid.Row="0" SizeChanged="OnRegionsCanvasSizeChanged" />
            <Slider
                x:Name="TimelineSlider"
                Grid.Row="1"
                Minimum="0"
                StepFrequency="0.001"
                Maximum="{x:Bind VM.SliderMaxSeconds, Mode=OneWay}"
                Value="{x:Bind VM.SliderSeconds, Mode=OneWay}"
                IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}"
                PointerCaptureLost="OnSliderReleased"
                ValueChanged="OnSliderValueChanged" />
        </Grid>

        <!--
            Transport on one line, readouts on the next: the scan buttons and the
            speed picker leave no room to keep them side by side, and a clipped
            frame counter is worse than a second row.
        -->
        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanBackButton" Content="◀◀" Command="{x:Bind VM.ScanBackwardCommand}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
                <Button Content="◀" Command="{x:Bind VM.StepBackwardCommand}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
                <Button x:Name="PlayPauseButton" MinWidth="90" Command="{x:Bind VM.PlayPauseCommand}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
                <Button Content="▶" Command="{x:Bind VM.StepForwardCommand}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
                <Button x:Name="ScanForwardButton" Content="▶▶" Command="{x:Bind VM.ScanForwardCommand}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
                <ComboBox
                    x:Name="SpeedCombo"
                    MinWidth="86"
                    IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}"
                    SelectionChanged="OnSpeedChanged" />
                <TextBlock
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind VM.ScanText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="FrameReadoutLabel" Opacity="0.6" VerticalAlignment="Center" FontSize="12" />
                <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{x:Bind VM.CurrentFrameText, Mode=OneWay}" />
                <TextBlock x:Name="TimeReadoutLabel" Opacity="0.6" VerticalAlignment="Center" FontSize="12" />
                <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{x:Bind VM.CurrentTimeText, Mode=OneWay}" />
                <TextBlock Opacity="0.6" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Text="{x:Bind VM.VideoInfoText, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind VM.PendingMarkText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!-- Mark buttons + export -->
        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="MarkStartButton" Command="{x:Bind VM.MarkStartCommand}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
            <Button x:Name="MarkEndButton" Command="{x:Bind VM.MarkEndCommand}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
            <Button x:Name="MarkLoadStartButton" Command="{x:Bind VM.MarkLoadStartCommand}" Visibility="{x:Bind Invert(SessionVM.IsSegmentMode), Mode=OneWay}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
            <Button x:Name="MarkLoadEndButton" Command="{x:Bind VM.MarkLoadEndCommand}" Visibility="{x:Bind Invert(SessionVM.IsSegmentMode), Mode=OneWay}" IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
        </StackPanel>

        <!-- Right: live time displays + shared marks sidebar -->
        <Grid Grid.Row="1" Grid.RowSpan="5" Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6">
                <Border Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource TimeCardLabelStyle}" Text="{x:Bind SessionVM.PrimaryLabel, Mode=OneWay}" />
                        <TextBlock FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{x:Bind SessionVM.PrimaryTimeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource TimeCardLabelStyle}" Text="{x:Bind SessionVM.SecondaryLabel, Mode=OneWay}" />
                        <TextBlock FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{x:Bind SessionVM.SecondaryTimeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <!--
                    Export lives here rather than at the end of the mark-button
                    row: five buttons on one line overflowed the content column
                    and clipped this one, and it is a primary action that should
                    not depend on the window being wide enough to see.
                -->
                <Button
                    x:Name="ExportButton"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind VM.ExportCommand}"
                    IsEnabled="{x:Bind VM.HasVideo, Mode=OneWay}" />
                <TextBlock x:Name="VideoStatusText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Text="{x:Bind VM.StatusText, Mode=OneWay}" />
            </StackPanel>
            <views:SessionSidebar Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
